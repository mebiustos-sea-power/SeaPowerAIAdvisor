<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border x:Name="SelectionShield" Background="Transparent" Visibility="Collapsed" />
  <Canvas IsHitTestVisible="False">
    <Border x:Name="SelectionOutline" BorderBrush="#FF4040" BorderThickness="2" Visibility="Collapsed" />
    <Border x:Name="SelectionHelp" Background="#DD17212B" Padding="10,6" Canvas.Left="12" Canvas.Top="12" Visibility="Collapsed">
      <TextBlock x:Name="SelectionHelpText" Foreground="White" TextWrapping="Wrap" MaxWidth="560" FontSize="14" />
    </Border>
  </Canvas>
  <Canvas>
    <Thumb x:Name="TranslationLauncher" Width="100" Height="34" Focusable="False" Cursor="Hand">
      <Thumb.ContextMenu>
        <ContextMenu>
          <MenuItem x:Name="RestoreOriginal" IsEnabled="False" />
        </ContextMenu>
      </Thumb.ContextMenu>
      <Thumb.ToolTip>
        <ToolTip />
      </Thumb.ToolTip>
      <Thumb.Template>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="ButtonBackground" Background="{DynamicResource Brush.Button.Background}" Padding="10,5">
            <TextBlock x:Name="ButtonText" Text="{TemplateBinding Tag}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource Brush.Button.Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ButtonBackground" Property="Background" Value="{DynamicResource Brush.Button.BackgroundOver}" />
              <Setter TargetName="ButtonText" Property="Foreground" Value="{DynamicResource Brush.Button.ForegroundOver}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBackground" Property="Opacity" Value="0.5" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Thumb.Template>
    </Thumb>
  </Canvas>
</Grid>
