<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SeaPowerAIAdvisor</AssemblyName>
    <RootNamespace>SeaPowerAIAdvisor</RootNamespace>
    <Version>0.16.0</Version>
    <FindDependenciesOfExternallyResolvedReferences>false</FindDependenciesOfExternallyResolvedReferences>
    <AssemblyVersion>0.16.0.0</AssemblyVersion>
    <FileVersion>0.16.0.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="AnchorChain" HintPath="$(AnchorChainDir)\AnchorChain.dll" Private="false" ExternallyResolved="true" />
    <Reference Include="BepInEx" HintPath="$(SeaPowerDir)\BepInEx\core\BepInEx.dll" Private="false" ExternallyResolved="true" />
    <Reference Include="0Harmony" HintPath="$(SeaPowerDir)\BepInEx\core\0Harmony.dll" Private="false" ExternallyResolved="true" />
    <Reference Include="Newtonsoft.Json" HintPath="$(SeaPowerDir)\Sea Power_Data\Managed\Newtonsoft.Json.dll" Private="false" ExternallyResolved="true" />
    <Reference Include="Seapower-Scripts" HintPath="$(SeaPowerDir)\Sea Power_Data\Managed\Seapower-Scripts.dll" Private="false" ExternallyResolved="true" />
    <Reference Include="ParadoxNotion" HintPath="$(SeaPowerDir)\Sea Power_Data\Managed\ParadoxNotion.dll" Private="false" ExternallyResolved="true" />
    <Reference Include="UniRx" HintPath="$(SeaPowerDir)\Sea Power_Data\Managed\UniRx.dll" Private="false" ExternallyResolved="true" />
    <Reference Include="Noesis.NoesisGUI" HintPath="$(SeaPowerDir)\Sea Power_Data\Managed\Noesis.NoesisGUI.dll" Private="false" ExternallyResolved="true" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(SeaPowerDir)\Sea Power_Data\Managed\UnityEngine.IMGUIModule.dll" Private="false" ExternallyResolved="true" />
    <Reference Include="UnityEngine.ParticleSystemModule" HintPath="$(SeaPowerDir)\Sea Power_Data\Managed\UnityEngine.ParticleSystemModule.dll" Private="false" ExternallyResolved="true" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(SeaPowerDir)\Sea Power_Data\Managed\UnityEngine.CoreModule.dll" Private="false" ExternallyResolved="true" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(SeaPowerDir)\Sea Power_Data\Managed\UnityEngine.ImageConversionModule.dll" Private="false" ExternallyResolved="true" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(SeaPowerDir)\Sea Power_Data\Managed\UnityEngine.InputLegacyModule.dll" Private="false" ExternallyResolved="true" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\api\SeaPowerAIAdvisor.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.0" GeneratePathProperty="true" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PkgMarkdig)\lib\netstandard2.1\Markdig.dll" LogicalName="SeaPowerAIAdvisor.Markdig.dll" />
    <EmbeddedResource Include="UI\Views\Advisor.xaml" LogicalName="SeaPowerAIAdvisor.Advisor.xaml" />
    <EmbeddedResource Include="UI\Views\AdvisorControls.xaml" LogicalName="SeaPowerAIAdvisor.AdvisorControls.xaml" />
    <EmbeddedResource Include="UI\Views\AdvisorHudButton.xaml" LogicalName="SeaPowerAIAdvisor.AdvisorHudButton.xaml" />
    <EmbeddedResource Include="UI\Views\AdvisorError.xaml" LogicalName="SeaPowerAIAdvisor.AdvisorError.xaml" />
    <EmbeddedResource Include="UI\Assets\advisor-default.png" LogicalName="SeaPowerAIAdvisor.DefaultPortrait.png" />
    <EmbeddedResource Include="UI\Localization\*.json" LogicalName="SeaPowerAIAdvisor.Localization.%(Filename).json" />
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(SeaPowerDir)\Sea Power_Data\Managed\Seapower-Scripts.dll')" Text="Set SeaPowerDir in Directory.Build.local.props." />
    <Error Condition="!Exists('$(AnchorChainDir)\AnchorChain.dll')" Text="Set AnchorChainDir in Directory.Build.local.props." />
  </Target>
  <ItemGroup>
    <Content Include="..\package\Prompts\*.json" Link="Prompts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
