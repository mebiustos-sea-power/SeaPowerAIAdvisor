<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="0,8,0,0">
              <Grid x:Name="ApiConnectionList">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button x:Name="AddApiConfiguration" Content="{DynamicResource AiConnection.profile.add}" Height="30" Padding="12,0" HorizontalAlignment="Left" Margin="0,0,0,10" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel x:Name="ApiConnectionCards" Margin="0,0,8,0" />
                </ScrollViewer>
              </Grid>
              <Grid x:Name="ApiEditor" Visibility="Collapsed">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Margin="0,0,8,0">
                    <Border Height="1" Background="#607080" Opacity="0.6" Margin="0,0,0,12" />
                    <TextBlock Text="{DynamicResource AiConnection.connection.configuration_name}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBox x:Name="ApiConfigurationName" FontSize="14" Padding="7" MaxLength="80" />
                    <TextBlock Text="{DynamicResource AiConnection.connection.provider}" FontSize="12" Margin="0,12,0,4" />
                    <ComboBox x:Name="ApiProvider" MinHeight="30" />
                    <Border x:Name="ApiProviderDescriptionBox" BorderBrush="#55606B" BorderThickness="1" Padding="8" Margin="0,8,0,0" Visibility="Collapsed">
                      <TextBlock x:Name="ApiProviderDescription" FontSize="12" TextWrapping="Wrap" Opacity="0.85" />
                    </Border>
                    <StackPanel x:Name="ApiProviderFields" />
                    <TextBlock x:Name="ApiProviderError" Foreground="#FF9B8F" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
                    <TextBlock Text="{DynamicResource AiConnection.connection.output_tokens}" FontSize="12" Margin="0,12,0,4" />
                    <TextBox x:Name="OutputTokens" FontSize="14" Padding="7" MaxLength="10" />
                    <TextBlock Text="{DynamicResource AiConnection.connection.request_timeout_label}" FontSize="12" Margin="0,12,0,4" />
                    <TextBox x:Name="RequestTimeout" FontSize="14" Padding="7" MaxLength="5" />
                    <StackPanel x:Name="ConnectionOptions" />
                    <TextBlock Text="{DynamicResource AiConnection.connection.prompt}" FontSize="12" Margin="0,12,0,4" />
                    <TextBlock Text="{DynamicResource AiConnection.connection.prompt_hint}" FontSize="11" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,6" />
                    <TextBox x:Name="ConnectionPrompt" Height="120" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="14" Padding="7" />
                    <Button x:Name="TestConnection" Content="{DynamicResource AiConnection.connection.test}" Height="30" Padding="12,0" Margin="0,12,0,0" />
                    <TextBlock x:Name="ConnectionTestStatus" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock x:Name="ConnectionTestError" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#FF9B8F" Visibility="Collapsed" />
                  </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="1" Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Button x:Name="DuplicateApiConfiguration" Content="{DynamicResource AiConnection.settings.duplicate}" Height="30" Padding="10,0" />
                  <Button x:Name="RemoveApiConfiguration" Grid.Column="1" Content="{DynamicResource AiConnection.profile.remove}" Height="30" Padding="10,0" Margin="8,0,0,0" />
                  <Button x:Name="CancelApiEntry" Grid.Column="3" Content="{DynamicResource AiConnection.settings.cancel}" Height="30" Padding="12,0" Margin="8,0,0,0" />
                  <Button x:Name="SaveApiEntry" Grid.Column="4" Content="{DynamicResource AiConnection.settings.save_form}" Height="30" Padding="12,0" Margin="8,0,0,0" />
                </Grid>
              </Grid>
            </Grid>
