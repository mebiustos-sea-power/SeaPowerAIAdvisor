<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="14">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto" />
    <RowDefinition Height="*" />
    <RowDefinition Height="Auto" />
  </Grid.RowDefinitions>
  <TextBlock x:Name="ErrorMessage" TextWrapping="Wrap" Foreground="#F0A896" Margin="0,0,0,12" />
  <Border Grid.Row="1" Background="#202B38" BorderBrush="#607080" BorderThickness="1">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10">
      <TextBlock x:Name="ErrorDetails" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
    </ScrollViewer>
  </Border>
  <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,12,0,0">
    <Button x:Name="CopyError" MinWidth="90" Padding="12,6" Margin="0,0,8,0" />
    <Button x:Name="RestartAdvisor" MinWidth="150" Padding="12,6" Margin="0,0,8,0" />
    <Button x:Name="CloseError" MinWidth="90" Padding="12,6" />
  </WrapPanel>
</Grid>
