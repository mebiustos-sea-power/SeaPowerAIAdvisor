<ToggleButton xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              Width="32" Height="32" FontSize="14" FontWeight="Bold" Focusable="False"
              Background="#898379" Foreground="#292429" BorderBrush="#4B5054">
  <ToggleButton.Template>
    <ControlTemplate TargetType="{x:Type ToggleButton}">
      <Grid Background="Transparent">
        <Border x:Name="Tile" Width="30" Height="31" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                SnapsToDevicePixels="True">
          <TextBlock Text="AI" FontFamily="{TemplateBinding FontFamily}"
                     FontSize="{TemplateBinding FontSize}" FontWeight="Bold"
                     Foreground="{TemplateBinding Foreground}" Stroke="{TemplateBinding Foreground}"
                     StrokeThickness="0.25" HorizontalAlignment="Center"
                     VerticalAlignment="Center" IsHitTestVisible="False" />
        </Border>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="Tile" Property="BorderBrush" Value="#ECE6CF" />
        </Trigger>
        <Trigger Property="IsChecked" Value="True">
          <Setter TargetName="Tile" Property="Background" Value="#F7C384" />
          <Setter TargetName="Tile" Property="BorderBrush" Value="#F8D4A7" />
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
  </ToggleButton.Template>
</ToggleButton>
