<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="0,8,0,0">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <TextBlock x:Name="Title" FontSize="18" TextWrapping="Wrap" Margin="0,0,0,10" />
  <WrapPanel x:Name="Actions" Grid.Row="1" Margin="0,0,0,10">
    <Button x:Name="Add" Content="{DynamicResource Crew.character.add}" Height="30" Padding="12,0" />
    <Button x:Name="Edit" Content="{DynamicResource Crew.edit_person}" Height="30" Padding="12,0" Margin="8,0,0,0" />
    <Button x:Name="Delete" Content="{DynamicResource Crew.portrait.delete}" Height="30" Padding="12,0" Margin="8,0,0,0" />
  </WrapPanel>
  <ScrollViewer x:Name="ListScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel><TextBlock x:Name="Empty" Text="{DynamicResource Crew.character.empty}" TextWrapping="Wrap" /><StackPanel x:Name="Characters" /></StackPanel>
  </ScrollViewer>
  <ScrollViewer x:Name="FormScroll" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,8,0">
      <Image x:Name="Portrait" Width="96" Height="96" Stretch="Uniform" HorizontalAlignment="Left" />
      <WrapPanel Margin="0,8,0,12">
        <Button x:Name="ChoosePortrait" Content="{DynamicResource Crew.choose_portrait}" Height="30" Padding="12,0" />
        <Button x:Name="CommonPortrait" Content="{DynamicResource Crew.common_portrait}" Height="30" Padding="12,0" Margin="8,0,0,0" />
      </WrapPanel>
      <TextBlock Text="{DynamicResource Crew.character.optional}" TextWrapping="Wrap" FontSize="12" Opacity="0.7" Margin="0,0,0,10" />
      <TextBlock Text="{DynamicResource Crew.person_name}" /><TextBox x:Name="Name" Margin="0,4,0,12" />
      <TextBlock Text="{DynamicResource Crew.person_rank}" /><TextBox x:Name="Rank" Margin="0,4,0,12" />
      <TextBlock Text="{DynamicResource Crew.person_personality}" />
      <TextBox x:Name="Personality" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" VerticalScrollBarVisibility="Auto" Margin="0,4,0,4" />
      <TextBlock Text="{DynamicResource Crew.person_personality_hint}" FontSize="12" Opacity="0.7" Margin="0,0,0,12" />
      <TextBlock Text="{DynamicResource Crew.character.gender}" /><ComboBox x:Name="Gender" Margin="0,4,0,12" />
      <TextBlock Text="{DynamicResource Crew.character.nationality}" /><TextBox x:Name="Nationality" Margin="0,4,0,12" />
      <TextBlock Text="{DynamicResource Crew.character.assignment_target}" /><ComboBox x:Name="AssignmentTarget" ToolTip="{DynamicResource Crew.character.assignment_target_hint}" Margin="0,4,0,12" />
      <TextBlock Text="{DynamicResource Crew.character.ai_appointment}" /><ComboBox x:Name="AiAppointment" Margin="0,4,0,12" />
      <CheckBox x:Name="AllowDuplicates" Content="{DynamicResource Crew.character.allow_duplicates}" Margin="0,0,0,8" />
    </StackPanel>
  </ScrollViewer>
  <TextBlock x:Name="Status" Grid.Row="3" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed" />
  <Grid Grid.Row="4" Margin="0,10,0,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <WrapPanel x:Name="Paging" HorizontalAlignment="Center">
      <Button x:Name="Previous" Content="{DynamicResource Crew.portrait.previous}" Height="30" Padding="12,0" />
      <TextBlock x:Name="Page" VerticalAlignment="Center" Margin="10,0" />
      <Button x:Name="Next" Content="{DynamicResource Crew.portrait.next}" Height="30" Padding="12,0" />
    </WrapPanel>
    <WrapPanel x:Name="FormButtons" Grid.Row="1" HorizontalAlignment="Right" Visibility="Collapsed">
      <Button x:Name="BackForm" Content="{DynamicResource Crew.person_back}" Height="30" Padding="12,0" />
      <Button x:Name="Save" Content="{DynamicResource Crew.save}" Height="30" Padding="12,0" Margin="8,0,0,0" />
    </WrapPanel>
    <WrapPanel x:Name="Selection" Grid.Row="1" HorizontalAlignment="Right" Visibility="Collapsed" Margin="0,10,0,0">
      <Button x:Name="Back" Content="{DynamicResource Crew.person_back}" Height="30" Padding="12,0" />
      <Button x:Name="Select" Content="{DynamicResource Crew.character.appoint}" Height="30" Padding="12,0" Margin="8,0,0,0" />
    </WrapPanel>
  </Grid>
</Grid>
