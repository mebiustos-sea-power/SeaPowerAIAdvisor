<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:spui="clr-namespace:SeapowerUI" Margin="14" TextElement.Foreground="{DynamicResource Brush.Foreground.Highlight}">
  <Grid.Resources>
    <DataTemplate x:Key="CrewWindowButtons"><Button Content="X" Width="24" Padding="0" Focusable="False" Command="{Binding CloseAction, RelativeSource={RelativeSource AncestorType={x:Type spui:Window}}}" /></DataTemplate>
  </Grid.Resources>
  <Grid.RowDefinitions>
    <RowDefinition Height="*" />
    <RowDefinition Height="Auto" />
  </Grid.RowDefinitions>
  <TabControl x:Name="Tabs" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <TabItem x:Name="HelpTab" Header="{DynamicResource Crew.help}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ContentControl x:Name="HelpContent" Margin="0,12,8,0" HorizontalContentAlignment="Stretch" />
      </ScrollViewer>
    </TabItem>
    <TabItem x:Name="HistoryTab" Header="{DynamicResource Crew.history}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Button x:Name="PauseReports" Content="{DynamicResource Crew.pause}" HorizontalAlignment="Right" Height="30" Padding="12,0" Margin="0,8,0,8" />
        <TextBlock x:Name="UsageSummary" Grid.Row="1" TextWrapping="Wrap" FontSize="12" Opacity="0.7" Margin="0,0,0,8" />
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="History" Margin="0,8,8,0" /></ScrollViewer>
      </Grid>
    </TabItem>
    <TabItem x:Name="TargetsTab" Header="{DynamicResource Crew.targets}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource Crew.targets_hint}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,10" />
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
          <Button x:Name="AllTargetsOn" Content="{DynamicResource Crew.all_on}" Height="30" Padding="12,0" />
          <Button x:Name="AllTargetsOff" Content="{DynamicResource Crew.all_off}" Height="30" Padding="12,0" Margin="8,0,0,0" />
        </WrapPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Targets" Margin="0,0,8,0" /></ScrollViewer>
        <Button x:Name="ApplyTargets" Grid.Row="3" Content="{DynamicResource Crew.apply_targets}" HorizontalAlignment="Right" Height="30" Padding="12,0" Margin="0,10,0,0" />
      </Grid>
    </TabItem>
    <TabItem x:Name="SettingsTab" Header="{DynamicResource Crew.settings}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <Grid Margin="0,8,0,0">
        <Grid x:Name="SettingsHome" VerticalAlignment="Top">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Button x:Name="OpenReports" Grid.Column="0" Content="{DynamicResource Crew.reports}" Height="64" Margin="4" FontSize="15" />
          <Button x:Name="OpenConnections" Grid.Column="1" Content="{DynamicResource Crew.connections}" Height="64" Margin="4" FontSize="15" />
          <Button x:Name="OpenInformation" Grid.Row="1" Grid.Column="0" Content="{DynamicResource Crew.information}" Height="64" Margin="4" FontSize="15" />
        </Grid>
        <Grid x:Name="SettingsPage" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock x:Name="SettingsCategoryTitle" FontSize="18" Margin="0,0,0,12" />
          <Grid Grid.Row="1">
            <TabControl x:Name="ApiTabs" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
              <TabItem x:Name="ApiSelect" Header="{DynamicResource Crew.connection_selection}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Margin="0,8,8,0">
                    <TextBlock Text="{DynamicResource Crew.connection_hint}" FontSize="12" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,12" />
                    <TextBlock Text="{DynamicResource Crew.report_connection}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <ComboBox x:Name="Connection" MinHeight="30" />
                    <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                      <Button x:Name="SaveConnection" Content="{DynamicResource Crew.save}" Height="30" Padding="12,0" Margin="8,0,0,0" />
                    </WrapPanel>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
              <TabItem x:Name="ApiEdit" Header="{DynamicResource Crew.registration}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"><ContentControl x:Name="Registration" /></TabItem>
            </TabControl>
            <ScrollViewer x:Name="ReportsSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="0,8,8,0">
                <TextBlock Text="{DynamicResource Crew.interval_hint}" FontSize="12" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,12" />
                <TextBlock Text="{DynamicResource Crew.interval}" FontSize="12" Margin="0,0,0,4" />
                <TextBox x:Name="Interval" Width="140" HorizontalAlignment="Left" FontSize="14" Padding="7" MaxLength="2" />
                <TextBlock Text="{DynamicResource Crew.exchange_chance}" FontSize="12" Margin="0,12,0,4" />
                <TextBox x:Name="ExchangeChance" Width="140" HorizontalAlignment="Left" FontSize="14" Padding="7" MaxLength="3" />
                <TextBlock Text="{DynamicResource Crew.exchange_chance_hint}" FontSize="12" TextWrapping="Wrap" Opacity="0.85" Margin="0,4,0,0" />
                <TextBlock Text="{DynamicResource Crew.position}" FontSize="12" Margin="0,12,0,6" />
                <ComboBox x:Name="NotificationPosition" MinHeight="30" />
                <TextBlock Text="{DynamicResource Crew.duration}" FontSize="12" Margin="0,12,0,4" />
                <TextBox x:Name="Duration" Width="140" HorizontalAlignment="Left" FontSize="14" Padding="7" MaxLength="2" />
                <CheckBox x:Name="ShowHelpTab" Content="{DynamicResource Crew.show_help_tab}" Margin="0,16,0,0" />
                <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                  <Button x:Name="SaveReports" Content="{DynamicResource Crew.save}" Height="30" Padding="12,0" Margin="8,0,0,0" />
                </WrapPanel>
              </StackPanel>
            </ScrollViewer>
            <Grid x:Name="InformationSettings" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,8,8,0">
                  <TextBlock Text="{DynamicResource Crew.information.hint}" FontSize="12" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,12" />
                  <StackPanel x:Name="InformationFixed">
                    <TextBlock Text="{DynamicResource Crew.information.always}" FontSize="14" FontWeight="Bold" Margin="0,0,0,8" />
                    <CheckBox IsChecked="True" IsEnabled="False" Margin="0,4,0,4"><TextBlock Text="{DynamicResource Crew.information.identity}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Foreground.Highlight}" /></CheckBox>
                    <CheckBox IsChecked="True" IsEnabled="False" Margin="0,4,0,4"><TextBlock Text="{DynamicResource Crew.information.formation}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Foreground.Highlight}" /></CheckBox>
                    <CheckBox IsChecked="True" IsEnabled="False" Margin="0,4,0,4"><TextBlock Text="{DynamicResource Crew.information.context}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Foreground.Highlight}" /></CheckBox>
                    <CheckBox IsChecked="True" IsEnabled="False" Margin="0,4,0,4"><TextBlock Text="{DynamicResource Crew.information.recent}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Foreground.Highlight}" /></CheckBox>
                  </StackPanel>
                  <TextBlock Text="{DynamicResource Crew.information.optional}" FontSize="14" FontWeight="Bold" Margin="0,20,0,8" />
                  <StackPanel x:Name="InformationChoices" />
                </StackPanel>
              </ScrollViewer>
              <Grid Grid.Row="1" Margin="0,10,0,0">
                <Button x:Name="ResetInformation" Content="{DynamicResource Crew.restore_defaults}" HorizontalAlignment="Left" Height="30" Padding="12,0" />
                <Button x:Name="SaveInformation" Content="{DynamicResource Crew.save}" HorizontalAlignment="Right" Height="30" Padding="12,0" />
              </Grid>
            </Grid>
          </Grid>
          <TextBlock x:Name="SettingsStatus" Grid.Row="2" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed" />
          <Button x:Name="Back" Grid.Row="3" Content="{DynamicResource Crew.back_categories}" Height="30" Padding="12,0" HorizontalAlignment="Right" Margin="0,12,0,0" />
        </Grid>
      </Grid>
    </TabItem>
  </TabControl>
  <Border x:Name="ReportStatusPane" Grid.Row="1">
    <TextBlock x:Name="ReportStatus" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed" />
  </Border>
  <Grid x:Name="Confirmation" Grid.RowSpan="2" Background="#B0000000" Visibility="Collapsed">
    <Border Background="#202B38" BorderBrush="#607080" BorderThickness="1" Padding="20" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel>
        <TextBlock x:Name="ConfirmationText" TextWrapping="Wrap" FontSize="14" />
        <WrapPanel HorizontalAlignment="Right" Margin="0,20,0,0">
          <Button x:Name="CancelConfirmation" Height="30" Padding="12,0" />
          <Button x:Name="Confirm" Height="30" Padding="12,0" Margin="8,0,0,0" />
        </WrapPanel>
      </StackPanel>
    </Border>
  </Grid>
</Grid>
