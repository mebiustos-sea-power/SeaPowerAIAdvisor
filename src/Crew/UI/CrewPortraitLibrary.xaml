<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="0,8,0,0">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <TextBlock x:Name="Title" FontSize="18" VerticalAlignment="Center" />
    <TextBlock x:Name="Count" Grid.Column="1" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
  </Grid>
  <Grid Grid.Row="1" Margin="0,10,0,10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <Button x:Name="Add" Content="{DynamicResource Crew.portrait.add}" Height="30" Padding="12,0" />
    <Button x:Name="Delete" Grid.Column="2" Content="{DynamicResource Crew.portrait.delete}" Height="30" Padding="12,0" IsEnabled="False" />
  </Grid>
  <Grid Grid.Row="2">
    <ScrollViewer x:Name="GalleryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock x:Name="Empty" Text="{DynamicResource Crew.portrait.empty}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
        <WrapPanel x:Name="Images" />
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="ImportScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
      <StackPanel Margin="0,0,8,0">
        <Image x:Name="Preview" Width="128" Height="128" Stretch="Uniform" HorizontalAlignment="Left" />
        <TextBlock x:Name="SourceName" TextWrapping="Wrap" Margin="0,8,0,0" />
        <TextBlock Text="{DynamicResource Crew.portrait.requirements}" FontSize="12" TextWrapping="Wrap" Opacity="0.85" Margin="0,8,0,12" />
        <WrapPanel HorizontalAlignment="Right">
          <Button x:Name="CancelImport" Content="{DynamicResource Crew.cancel}" Height="30" Padding="12,0" />
          <Button x:Name="SaveImport" Content="{DynamicResource Crew.portrait.import}" Height="30" Padding="12,0" Margin="8,0,0,0" />
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
  <TextBlock x:Name="Status" Grid.Row="3" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed" />
  <Grid Grid.Row="4" Margin="0,10,0,0">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <WrapPanel x:Name="Paging" HorizontalAlignment="Center">
      <Button x:Name="Previous" Content="{DynamicResource Crew.portrait.previous}" Height="30" Padding="12,0" />
      <TextBlock x:Name="Page" VerticalAlignment="Center" Margin="10,0" />
      <Button x:Name="Next" Content="{DynamicResource Crew.portrait.next}" Height="30" Padding="12,0" />
    </WrapPanel>
    <WrapPanel x:Name="Selection" Grid.Row="1" HorizontalAlignment="Right" Margin="0,10,0,0" Visibility="Collapsed">
      <Button x:Name="Back" Content="{DynamicResource Crew.person_back}" Height="30" Padding="12,0" />
    </WrapPanel>
  </Grid>
</Grid>
