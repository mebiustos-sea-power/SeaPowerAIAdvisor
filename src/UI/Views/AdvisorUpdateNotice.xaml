<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="16"
      TextElement.Foreground="{DynamicResource Brush.Foreground.Highlight}">
  <Grid.RowDefinitions>
    <RowDefinition Height="*" />
    <RowDefinition Height="Auto" />
    <RowDefinition Height="Auto" />
  </Grid.RowDefinitions>
  <ScrollViewer x:Name="UpdateNoticeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
  <TextBlock x:Name="UpdateNoticeFailure" Grid.Row="1" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" />
  <Button x:Name="CloseUpdateNotice" Grid.Row="2" Height="30" Padding="12,0" HorizontalAlignment="Right" Margin="0,16,0,0" />
</Grid>
