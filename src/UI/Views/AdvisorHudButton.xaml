<ToggleButton xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              Width="32" Height="32" FontSize="14" FontWeight="Bold" Focusable="False"
              Background="#898379" Foreground="#292429" BorderBrush="#4B5054">
  <ToggleButton.Content>
    <Ellipse Width="8" Height="8" Fill="#FFE060" Stroke="#292429" StrokeThickness="1"
             Visibility="Collapsed" IsHitTestVisible="False" />
  </ToggleButton.Content>
  <ToggleButton.Template>
    <ControlTemplate TargetType="{x:Type ToggleButton}">
      <Grid Background="Transparent">
        <Border x:Name="Tile" MaxWidth="30" MaxHeight="31" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                SnapsToDevicePixels="True">
          <TextBlock Text="AI" FontFamily="{TemplateBinding FontFamily}"
                     FontSize="{TemplateBinding FontSize}" FontWeight="Bold"
                     Foreground="{TemplateBinding Foreground}" Stroke="{TemplateBinding Foreground}"
                     StrokeThickness="0.25" HorizontalAlignment="Center"
                     VerticalAlignment="Center" IsHitTestVisible="False" />
        </Border>
        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Right"
                          VerticalAlignment="Top" Margin="1" IsHitTestVisible="False" />
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="Tile" Property="BorderBrush" Value="#ECE6CF" />
        </Trigger>
        <Trigger Property="IsChecked" Value="True">
          <Setter TargetName="Tile" Property="Background" Value="#F7C384" />
          <Setter TargetName="Tile" Property="BorderBrush" Value="#F8D4A7" />
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
  </ToggleButton.Template>
</ToggleButton>
