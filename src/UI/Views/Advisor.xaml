<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="14" TextElement.Foreground="{DynamicResource Brush.Foreground.Highlight}">
  <Grid.Resources>
    <SolidColorBrush x:Key="AdvisorConversationBackgroundBrush" Color="#202B38" />
    <SolidColorBrush x:Key="AdvisorErrorBrush" Color="#FF9B8F" />
    <SolidColorBrush x:Key="AdvisorPlayerNameBrush" Color="#9BC7FF" />
    <SolidColorBrush x:Key="AdvisorNameBrush" Color="#E8D39A" />
    <SolidColorBrush x:Key="AdvisorTrackNormalBrush" Color="#B9A883" />
    <SolidColorBrush x:Key="AdvisorOwnUnitNormalBrush" Color="#A0C4D8" />
    <SolidColorBrush x:Key="AdvisorTrackHoverBrush" Color="#FFFFFF" />
    <Style x:Key="AdvisorTrackLinkStyle" TargetType="{x:Type Hyperlink}">
      <Setter Property="Foreground" Value="{StaticResource AdvisorTrackNormalBrush}" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="{StaticResource AdvisorTrackHoverBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="AdvisorOwnUnitLinkStyle" TargetType="{x:Type Hyperlink}" BasedOn="{StaticResource AdvisorTrackLinkStyle}">
      <Setter Property="Foreground" Value="{StaticResource AdvisorOwnUnitNormalBrush}" />
    </Style>
    <Style x:Key="AdvisorPlainLinkStyle" TargetType="{x:Type Hyperlink}" BasedOn="{StaticResource AdvisorTrackLinkStyle}">
      <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TextBlock}}}" />
    </Style>
    <Style x:Key="AdvisorWeaponLinkStyle" TargetType="{x:Type Hyperlink}" BasedOn="{StaticResource AdvisorPlainLinkStyle}" />
    <Style x:Key="AdvisorUnitBadgeLinkStyle" TargetType="{x:Type Hyperlink}" BasedOn="{StaticResource AdvisorPlainLinkStyle}" />
  </Grid.Resources>
  <Grid x:Name="ConversationPane">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="100" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="150" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel VerticalAlignment="Top">
          <Border Background="#202B38" BorderBrush="#607080" BorderThickness="1" Padding="4">
            <Grid Height="140">
              <Image x:Name="Portrait" Stretch="Uniform" />
              <TextBlock x:Name="PortraitError" Text="{DynamicResource Advisor.portrait.error}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" />
            </Grid>
          </Border>
          <TextBlock x:Name="AdvisorName" Text="Michael Reed" TextWrapping="Wrap" TextAlignment="Center" FontSize="17" Margin="0,10,0,0" />
          <TextBlock x:Name="AdvisorRole" Text="{DynamicResource Advisor.advisor.role}" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Margin="0,5,0,0" Opacity="0.7" />
          <TextBlock x:Name="Activity" Text="{DynamicResource Advisor.activity.idle}" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Margin="0,12,0,0" Opacity="0.8" />
          <StackPanel Margin="0,18,0,0">
            <TextBlock Text="{DynamicResource Advisor.quick.heading}" FontSize="12" TextAlignment="Center" Margin="0,0,0,8" Opacity="0.8" />
            <Button x:Name="NextSteps" Content="{DynamicResource Advisor.preset.next_steps}" ToolTip="{DynamicResource Advisor.preset.next_steps_tip}" Height="32" Margin="0,0,0,4" />
            <Button x:Name="KeyRisks" Content="{DynamicResource Advisor.preset.key_risks}" ToolTip="{DynamicResource Advisor.preset.key_risks_tip}" Height="32" Margin="0,0,0,4" />
            <Button x:Name="RadarOperations" Content="{DynamicResource Advisor.preset.radar_operations}" ToolTip="{DynamicResource Advisor.preset.radar_operations_tip}" Height="32" Margin="0,0,0,4" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button x:Name="OwnUnits" Content="{DynamicResource Advisor.preset.own_units}" ToolTip="{DynamicResource Advisor.preset.own_units_tip}" Height="32" />
              <Button x:Name="Contacts" Grid.Column="2" Content="{DynamicResource Advisor.preset.contacts}" ToolTip="{DynamicResource Advisor.preset.contacts_tip}" Height="32" />
            </Grid>
            <ToggleButton x:Name="OtherConsultations" Template="{DynamicResource AdvisorHoverToggleTemplate}" Content="{DynamicResource Advisor.quick.other}" Height="32" Margin="0,4,0,0" IsChecked="False" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <Grid Grid.Column="2" MinHeight="120">
        <Border x:Name="ConversationHistory" BorderBrush="#607080" BorderThickness="1" Background="{StaticResource AdvisorConversationBackgroundBrush}">
          <ScrollViewer x:Name="Transcript" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10" HorizontalContentAlignment="Stretch">
            <StackPanel x:Name="TranscriptMessages" />
          </ScrollViewer>
        </Border>
        <ScrollViewer x:Name="OtherConsultationsPane" Visibility="Collapsed" Margin="10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="OtherConsultationGroups" Margin="0,0,8,0" />
        </ScrollViewer>
      </Grid>
    </Grid>
    <Grid Grid.Row="1" Margin="0,10,0,5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="150" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{DynamicResource Advisor.question.label}" FontSize="13" VerticalAlignment="Center" />
      <Grid Grid.Column="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="UnitNavigationHint" Text="{DynamicResource Advisor.transcript.unit_navigation_hint}" FontSize="12" VerticalAlignment="Center" TextAlignment="Left" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" Opacity="0.7" Visibility="Collapsed" />
        <Button x:Name="Clear" Grid.Column="1" Content="{DynamicResource Advisor.action.clear}" Height="18" FontSize="12" Padding="8,0" VerticalAlignment="Center" />
      </Grid>
    </Grid>
    <Grid Grid.Row="2">
      <TextBox x:Name="Question" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontSize="15" Padding="8" />
      <ScrollViewer x:Name="UnitBadgeArea" VerticalAlignment="Top" Margin="8,6,8,0" MaxHeight="48" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Visibility="Collapsed">
        <WrapPanel x:Name="UnitBadges" />
      </ScrollViewer>
    </Grid>
    <Grid Grid.Row="3" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button x:Name="Settings" Content="{DynamicResource Advisor.action.settings}" Height="30" Padding="12,0" />
      <Button x:Name="InsertSelectedUnit" Grid.Column="1" Content="{DynamicResource Advisor.action.insert_selected_unit}" Height="30" Padding="10,0" Margin="8,0,0,0" Focusable="False" Visibility="Collapsed" />
      <Button x:Name="ClearInput" Grid.Column="3" Content="{DynamicResource Advisor.action.clear_input}" Height="30" Padding="10,0" Margin="8,0,0,0" Focusable="False" />
      <Button x:Name="Send" Grid.Column="4" Content="{DynamicResource Advisor.action.send}" MinWidth="70" Height="30" Margin="8,0,0,0" />
    </Grid>
    <TextBlock x:Name="Status" Grid.Row="4" Text="{DynamicResource Advisor.status.ready}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
  </Grid>
  <Grid x:Name="SettingsPane" Visibility="Collapsed">
    <Grid x:Name="SettingsHome">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Text="{DynamicResource Advisor.pane.settings}" FontSize="18" Margin="0,0,0,16" />
      <Grid Grid.Row="1" VerticalAlignment="Top">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Button x:Name="OpenGeneralCategory" Grid.Row="0" Grid.Column="0" Content="{DynamicResource Advisor.general.tab}" Height="64" Margin="4" FontSize="15" />
        <Button x:Name="OpenProfileCategory" Grid.Row="0" Grid.Column="1" Content="{DynamicResource Advisor.profile.tab}" Height="64" Margin="4" FontSize="15" />
        <Button x:Name="OpenTemplatesCategory" Grid.Row="1" Grid.Column="0" Content="{DynamicResource Advisor.templates.category}" Height="64" Margin="4" FontSize="15" />
        <Button x:Name="OpenApiCategory" Grid.Row="1" Grid.Column="1" Content="{DynamicResource Advisor.settings.api_category}" Height="64" Margin="4" FontSize="15" />
        <Button x:Name="OpenConsultationCategory" Grid.Row="2" Grid.Column="0" Content="{DynamicResource Advisor.ai.consultation}" Height="64" Margin="4" FontSize="15" />
        <Button x:Name="OpenCommandsCategory" Grid.Row="2" Grid.Column="1" Content="{DynamicResource Advisor.commands.category}" Height="64" Margin="4" FontSize="15" />
        <Button x:Name="OpenInformationCategory" Grid.Row="3" Grid.Column="0" Content="{DynamicResource Advisor.information.tab}" Height="64" Margin="4" FontSize="15" />
        <Button x:Name="OpenWipCategory" Grid.Row="3" Grid.Column="1" Content="{DynamicResource Advisor.wip.category}" Height="64" Margin="4" FontSize="15" />
        <Button x:Name="OpenDeveloperCategory" Grid.Row="4" Grid.Column="0" Content="{DynamicResource Advisor.diagnostics.heading}" Height="64" Margin="4" FontSize="15" />
      </Grid>
      <Button x:Name="BackToConversation" Grid.Row="2" Content="{DynamicResource Advisor.settings.back_chat}" Height="30" Padding="12,0" HorizontalAlignment="Right" Margin="0,12,0,0" />
    </Grid>
    <Grid x:Name="SettingsCategoryPage" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock x:Name="SettingsCategoryTitle" FontSize="18" Margin="0,0,0,12" />
      <Grid Grid.Row="1">
        <Grid x:Name="GeneralCategory" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,8,8,0">
              <TextBlock Text="{DynamicResource Advisor.general.user_name}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" />
              <TextBox x:Name="UserName" FontSize="14" Padding="7" />
              <TextBlock Text="{DynamicResource Advisor.general.conversation_display}" FontSize="14" FontWeight="Bold" Margin="0,24,0,10" />
              <CheckBox x:Name="LinkOwnUnits" HorizontalContentAlignment="Stretch" Margin="0,0,0,8">
                <TextBlock Text="{DynamicResource Advisor.general.own_unit_links}" TextWrapping="Wrap" />
              </CheckBox>
              <CheckBox x:Name="LinkContacts" HorizontalContentAlignment="Stretch" Margin="0,0,0,8">
                <TextBlock Text="{DynamicResource Advisor.general.contact_links}" TextWrapping="Wrap" />
              </CheckBox>
              <TextBlock Text="{DynamicResource Advisor.general.text_size}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,6" />
              <ComboBox x:Name="ConversationTextSize" Width="160" HorizontalAlignment="Left">
                <ComboBoxItem Content="{DynamicResource Advisor.general.text_size_small}" />
                <ComboBoxItem Content="{DynamicResource Advisor.general.text_size_standard}" />
                <ComboBoxItem Content="{DynamicResource Advisor.general.text_size_large}" />
              </ComboBox>
              <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="SaveGeneral" Content="{DynamicResource Advisor.settings.save_form}" Height="30" Padding="12,0" Margin="8,0,0,0" />
              </WrapPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
        <TabControl x:Name="ProfileCategory" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
          <TabItem x:Name="AdvisorUseTab" Header="{DynamicResource Advisor.settings.selection_tab}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="0,8,8,0">
                <TextBlock Text="{DynamicResource Advisor.profile.selection_hint}" FontSize="12" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,12" />
                <TextBlock Text="{DynamicResource Advisor.settings.active_advisor}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" />
                <ComboBox x:Name="ActiveAdvisorSelector" MinHeight="30" />
                <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                  <Button x:Name="SaveAdvisorSelection" Content="{DynamicResource Advisor.settings.save_form}" Height="30" Padding="12,0" Margin="8,0,0,0" />
                </WrapPanel>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="{DynamicResource Advisor.settings.registration_tab}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="0,8,8,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ComboBox x:Name="AdvisorSelector" MinHeight="30" />
                  <Button x:Name="AddAdvisor" Grid.Column="1" Content="{DynamicResource Advisor.profile.add}" Height="30" Padding="10,0" Margin="8,0,0,0" />
                  <Button x:Name="EditAdvisor" Grid.Column="2" Content="{DynamicResource Advisor.settings.edit}" Height="30" Padding="10,0" Margin="8,0,0,0" />
                  <Button x:Name="RemoveAdvisor" Grid.Column="3" Content="{DynamicResource Advisor.profile.remove}" Height="30" Padding="10,0" Margin="8,0,0,0" />
                </Grid>
                <StackPanel x:Name="ProfileEditor" Visibility="Collapsed" Margin="0,16,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="120" />
                      <ColumnDefinition Width="16" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <Border Background="#202B38" BorderBrush="#607080" BorderThickness="1" Padding="4" Width="120" Height="120">
                        <Grid>
                          <Image x:Name="ProfilePreview" Stretch="Uniform" />
                          <TextBlock x:Name="ProfilePreviewError" Text="{DynamicResource Advisor.portrait.settings_error}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                        </Grid>
                      </Border>
                      <Button x:Name="ChoosePortrait" Content="{DynamicResource Advisor.action.choose_portrait}" Height="30" Padding="12,0" Margin="0,8,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="{DynamicResource Advisor.profile.name}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" />
                      <TextBox x:Name="ProfileName" FontSize="14" Padding="7" MaxLength="80" />
                      <TextBlock Text="{DynamicResource Advisor.profile.role}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,4" />
                      <TextBox x:Name="ProfileRole" FontSize="14" Padding="7" MaxLength="80" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="{DynamicResource Advisor.profile.personality}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,4" />
                  <TextBox x:Name="ProfilePersonality" Height="110" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="14" Padding="7" />
                  <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button x:Name="CancelProfileEntry" Content="{DynamicResource Advisor.settings.cancel}" Height="30" Padding="12,0" Margin="8,0,0,0" />
                    <Button x:Name="SaveProfileEntry" Content="{DynamicResource Advisor.settings.save_form}" Height="30" Padding="12,0" Margin="8,0,0,0" />
                  </WrapPanel>
                </StackPanel>
                <TextBlock x:Name="ProfileStatus" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
        <Grid x:Name="TemplatesCategory" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Margin="0,8,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="TemplateSelector" MinHeight="30" />
            <Button x:Name="AddTemplate" Grid.Column="1" Content="{DynamicResource Advisor.templates.add}" Height="30" Padding="10,0" Margin="8,0,0,0" />
            <Button x:Name="EditTemplate" Grid.Column="2" Content="{DynamicResource Advisor.settings.edit}" Height="30" Padding="10,0" Margin="8,0,0,0" />
            <Button x:Name="RemoveTemplate" Grid.Column="3" Content="{DynamicResource Advisor.templates.remove}" Height="30" Padding="10,0" Margin="8,0,0,0" />
          </Grid>
          <Grid x:Name="TemplateEditor" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource Advisor.templates.name}" FontSize="12" Margin="0,0,0,4" />
            <TextBox x:Name="TemplateName" Grid.Row="1" FontSize="14" Padding="7" />
            <TextBlock Grid.Row="2" Text="{DynamicResource Advisor.templates.message}" FontSize="12" Margin="0,12,0,4" />
            <TextBox x:Name="TemplateMessage" Grid.Row="3" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontSize="14" Padding="7" />
            <WrapPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,12,0,0">
              <Button x:Name="CancelTemplate" Content="{DynamicResource Advisor.settings.cancel}" Height="30" Padding="12,0" />
              <Button x:Name="SaveTemplate" Content="{DynamicResource Advisor.settings.save_form}" Height="30" Padding="12,0" Margin="8,0,0,0" />
            </WrapPanel>
          </Grid>
        </Grid>
        <TabControl x:Name="ApiCategory" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
          <TabItem x:Name="ApiUseTab" Header="{DynamicResource Advisor.settings.selection_tab}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="0,8,8,0">
                <TextBlock Text="{DynamicResource Advisor.connection.selection_hint}" FontSize="12" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,12" />
                <TextBlock Text="{DynamicResource Advisor.connection.main_heading}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" />
                <ComboBox x:Name="MainApiConfiguration" MinHeight="30" />
                <TextBlock Text="{DynamicResource Advisor.connection.sub_heading}" FontSize="12" TextWrapping="Wrap" Margin="0,20,0,6" />
                <TextBlock Text="{DynamicResource Advisor.connection.fallback_hint}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                <ComboBox x:Name="SubApiConfiguration" MinHeight="30" />
                <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                  <Button x:Name="SaveApiAssignments" Content="{DynamicResource Advisor.settings.save_form}" Height="30" Padding="12,0" Margin="8,0,0,0" />
                </WrapPanel>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem x:Name="ApiEditTab" Header="{DynamicResource Advisor.settings.registration_tab}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid Margin="0,8,0,0">
              <Grid x:Name="ApiConnectionList">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button x:Name="AddApiConfiguration" Content="{DynamicResource Advisor.profile.add}" Height="30" Padding="12,0" HorizontalAlignment="Left" Margin="0,0,0,10" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel x:Name="ApiConnectionCards" Margin="0,0,8,0" />
                </ScrollViewer>
              </Grid>
              <Grid x:Name="ApiEditor" Visibility="Collapsed">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel Margin="0,0,8,0">
                    <Border Height="1" Background="#607080" Opacity="0.6" Margin="0,0,0,12" />
                    <TextBlock Text="{DynamicResource Advisor.connection.configuration_name}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBox x:Name="ApiConfigurationName" FontSize="14" Padding="7" MaxLength="80" />
                    <TextBlock Text="{DynamicResource Advisor.connection.provider}" FontSize="12" Margin="0,12,0,4" />
                    <ComboBox x:Name="ApiProvider" MinHeight="30" />
                    <Border x:Name="ApiProviderDescriptionBox" BorderBrush="#55606B" BorderThickness="1" Padding="8" Margin="0,8,0,0" Visibility="Collapsed">
                      <TextBlock x:Name="ApiProviderDescription" FontSize="12" TextWrapping="Wrap" Opacity="0.85" />
                    </Border>
                    <StackPanel x:Name="ApiProviderFields" />
                    <TextBlock x:Name="ApiProviderError" Foreground="{DynamicResource AdvisorErrorBrush}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
                    <TextBlock Text="{DynamicResource Advisor.connection.output_tokens}" FontSize="12" Margin="0,12,0,4" />
                    <TextBox x:Name="OutputTokens" FontSize="14" Padding="7" MaxLength="10" />
                    <TextBlock Text="{DynamicResource Advisor.connection.request_timeout_label}" FontSize="12" Margin="0,12,0,4" />
                    <TextBox x:Name="RequestTimeout" FontSize="14" Padding="7" MaxLength="5" />
                    <StackPanel x:Name="SituationDeliveryPanel" Margin="0,12,0,0">
                      <TextBlock Text="{DynamicResource Advisor.connection.situation_delivery}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" />
                      <TextBlock Text="{DynamicResource Advisor.connection.situation_delivery_hint}" FontSize="11" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,6" />
                      <ComboBox x:Name="SituationDelivery" MinHeight="30" />
                    </StackPanel>
                    <Button x:Name="TestConnection" Content="{DynamicResource Advisor.connection.test}" Height="30" Padding="12,0" Margin="0,12,0,0" />
                    <TextBlock x:Name="ConnectionTestStatus" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock x:Name="ConnectionTestError" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource AdvisorErrorBrush}" Visibility="Collapsed" />
                  </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="1" Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Button x:Name="DuplicateApiConfiguration" Content="{DynamicResource Advisor.settings.duplicate}" Height="30" Padding="10,0" />
                  <Button x:Name="RemoveApiConfiguration" Grid.Column="1" Content="{DynamicResource Advisor.profile.remove}" Height="30" Padding="10,0" Margin="8,0,0,0" />
                  <Button x:Name="CancelApiEntry" Grid.Column="3" Content="{DynamicResource Advisor.settings.cancel}" Height="30" Padding="12,0" Margin="8,0,0,0" />
                  <Button x:Name="SaveApiEntry" Grid.Column="4" Content="{DynamicResource Advisor.settings.save_form}" Height="30" Padding="12,0" Margin="8,0,0,0" />
                </Grid>
              </Grid>
            </Grid>
          </TabItem>
          <TabItem x:Name="ApiErrorsTab" Header="{DynamicResource Advisor.errorlog.tab}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid Margin="0,8,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock x:Name="ApiErrorHistoryStatus" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
              <TextBox x:Name="ApiErrorHistoryDetails" Grid.Row="1" FontSize="13" Padding="7" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
            </Grid>
          </TabItem>
        </TabControl>
        <Grid x:Name="ConsultationCategory" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,8,8,0">
              <TextBlock Text="{DynamicResource Advisor.ai.answer_policy}" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" />
              <TextBlock Text="{DynamicResource Advisor.ai.common_prompt}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" />
              <TextBox x:Name="CommonPrompt" Height="150" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="14" Padding="7" />
              <TextBlock Text="{DynamicResource Advisor.ai.history_retrieval}" FontSize="14" FontWeight="Bold" Margin="0,24,0,10" />
              <TextBlock Text="{DynamicResource Advisor.ai.history_exchanges}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" />
              <TextBox x:Name="HistoryExchanges" Width="80" HorizontalAlignment="Left" FontSize="14" Padding="7" MaxLength="2" />
              <TextBlock Text="{DynamicResource Advisor.ai.max_query_rounds}" FontSize="12" TextWrapping="Wrap" Margin="0,18,0,4" />
              <TextBox x:Name="MaxQueryRounds" Width="80" HorizontalAlignment="Left" FontSize="14" Padding="7" MaxLength="2" />
              <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="SaveConsultation" Content="{DynamicResource Advisor.settings.save_form}" Height="30" Padding="12,0" Margin="8,0,0,0" />
              </WrapPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
        <Grid x:Name="CommandsCategory" Visibility="Collapsed">
          <Grid x:Name="CommandList">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <CheckBox x:Name="EnableUnitOperations" Content="{DynamicResource Advisor.commands.enabled}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <Button x:Name="CommandTools" Grid.Column="1" Content="{DynamicResource Advisor.commands.tools}" Height="30" Padding="12,0" />
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="CommandEntries" Margin="0,0,8,0" />
            </ScrollViewer>
            <Button x:Name="SaveCommands" Grid.Row="2" Content="{DynamicResource Advisor.settings.save_form}" HorizontalAlignment="Right" Height="30" Padding="12,0" Margin="0,10,0,0" />
          </Grid>
          <Grid x:Name="CommandDetails" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,12">
              <TextBlock x:Name="CommandTitle" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
              <TextBlock x:Name="CommandId" FontSize="11" TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,0" />
            </StackPanel>
            <TabControl x:Name="CommandDetailTabs" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
              <TabItem Header="{DynamicResource Advisor.commands.about}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,8,8,0">
                  <TextBlock x:Name="CommandHelp" FontSize="13" TextWrapping="Wrap" />
                </ScrollViewer>
              </TabItem>
              <TabItem Header="{DynamicResource Advisor.commands.prompt}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <TextBox x:Name="CommandPrompt" Margin="0,8,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontSize="13" Padding="7" />
              </TabItem>
              <TabItem Header="{DynamicResource Advisor.commands.definition}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <TextBox x:Name="CommandDefinition" Margin="0,8,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontSize="13" Padding="7" />
              </TabItem>
            </TabControl>
            <Button x:Name="BackToCommands" Grid.Row="2" Content="{DynamicResource Advisor.commands.back}" Height="30" Padding="12,0" HorizontalAlignment="Right" Margin="0,12,0,0" />
          </Grid>
        </Grid>
        <Grid x:Name="InformationCategory" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="{DynamicResource Advisor.information.mandatory}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBlock Text="{DynamicResource Advisor.information.player_knowledge}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="InformationChoices" Margin="0,0,8,0" />
          </ScrollViewer>
          <Grid Grid.Row="2" Margin="0,10,0,0">
            <Button x:Name="ResetInformation" Content="{DynamicResource Advisor.information.restore_defaults}" HorizontalAlignment="Left" Height="30" Padding="12,0" />
            <Button x:Name="SaveInformation" Content="{DynamicResource Advisor.settings.save_form}" HorizontalAlignment="Right" Height="30" Padding="12,0" />
          </Grid>
        </Grid>
        <Grid x:Name="WipCategory" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,8,8,0">
              <CheckBox x:Name="EnableCampaignAdvisor" HorizontalContentAlignment="Stretch">
                <TextBlock Text="{DynamicResource Advisor.wip.campaign_alpha}" TextWrapping="Wrap" />
              </CheckBox>
              <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="SaveWip" Content="{DynamicResource Advisor.settings.save_form}" Height="30" Padding="12,0" Margin="8,0,0,0" />
              </WrapPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
        <TabControl x:Name="DeveloperCategory" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
          <TabItem Header="{DynamicResource Advisor.developer.diagnostics}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid x:Name="DeveloperDiagnosticsPane">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel>
                <CheckBox x:Name="LogAiJson" Content="{DynamicResource Advisor.developer.log_ai_json}" Margin="0,0,0,8" />
                <WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0">
                  <Button x:Name="SaveDeveloper" Content="{DynamicResource Advisor.settings.save_form}" Height="30" Padding="12,0" Margin="8,0,0,0" />
                </WrapPanel>
                <TextBlock Text="{DynamicResource Advisor.profile.path}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,4" />
                <TextBox x:Name="ProfilePath" IsReadOnly="True" TextWrapping="Wrap" FontSize="12" Padding="6" />
                <WrapPanel Margin="0,12,0,6">
                  <Button x:Name="Capture" Content="{DynamicResource Advisor.action.capture}" Height="30" Padding="12,0" Margin="0,0,8,0" />
                  <Button x:Name="Input" Content="{DynamicResource Advisor.action.input}" Height="30" Padding="12,0" Margin="0,0,8,0" />
                  <Button x:Name="ThrowTestException" Content="{DynamicResource Advisor.developer.throw_exception}" Height="30" Padding="12,0" />
                </WrapPanel>
                <TextBlock Text="{DynamicResource Advisor.developer.throw_exception_note}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
              </StackPanel>
              <TextBox x:Name="DiagnosticOutput" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontSize="12" Padding="8" />
              <TextBlock x:Name="DiagnosticStatus" Grid.Row="2" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
            </Grid>
          </TabItem>
          <TabItem Header="{DynamicResource Advisor.developer.local_api_tab}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid Margin="0,8,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                  <CheckBox x:Name="EnableLocalApi" Content="{DynamicResource Advisor.developer.local_api}" Margin="0,0,0,8" />
                  <CheckBox x:Name="AllowLocalApiModelOverride" Content="{DynamicResource Advisor.developer.local_api_model_override}" Margin="0,0,0,8" />
                  <TextBlock x:Name="LocalApiStatus" FontSize="12" TextWrapping="Wrap" />
                  <TextBlock Text="{DynamicResource Advisor.developer.local_api_connections}" FontWeight="Bold" Margin="0,16,0,6" />
                  <StackPanel x:Name="LocalApiConnections" />
                  <TextBlock Text="{DynamicResource Advisor.developer.local_api_default}" Margin="0,16,0,6" />
                  <ComboBox x:Name="LocalApiDefaultConnection" MinHeight="30" />
                </StackPanel>
              </ScrollViewer>
              <Button x:Name="SaveLocalApi" Grid.Row="1" Content="{DynamicResource Advisor.settings.save_form}" HorizontalAlignment="Right" Height="30" Padding="12,0" Margin="0,10,0,0" />
            </Grid>
          </TabItem>
          <TabItem Header="{DynamicResource Advisor.developer.prompts.tab}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid Margin="0,8,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="{DynamicResource Advisor.developer.prompts.description}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="{DynamicResource Advisor.developer.prompts.file}" FontSize="12" Margin="0,0,8,4" />
                  <TextBlock Grid.Column="1" Text="ID" FontSize="12" Margin="0,0,0,4" />
                  <ComboBox x:Name="PromptFile" Grid.Row="1" Height="30" Margin="0,0,8,0" />
                  <ComboBox x:Name="PromptId" Grid.Row="1" Grid.Column="1" Height="30" />
                </Grid>
                <TextBox x:Name="SelectedPromptText" Height="120" FontSize="14" Padding="7" Margin="0,8,0,12" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
                <TextBlock Text="{DynamicResource Advisor.developer.prompts.all}" FontSize="13" FontWeight="Bold" Margin="0,0,0,8" />
              </StackPanel>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PromptFields" Margin="0,0,8,0" />
              </ScrollViewer>
              <TextBlock x:Name="PromptStatus" Grid.Row="2" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
              <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="ResetPrompts" Content="{DynamicResource Advisor.developer.prompts.reset}" Height="30" Padding="12,0" />
                <Button x:Name="ApplyPrompts" Content="{DynamicResource Advisor.developer.prompts.apply}" Height="30" Padding="12,0" Margin="8,0,0,0" />
              </WrapPanel>
            </Grid>
          </TabItem>
        </TabControl>
      </Grid>
      <TextBlock x:Name="SettingsStatus" Grid.Row="2" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed" />
      <Button x:Name="BackToSettings" Grid.Row="3" Content="{DynamicResource Advisor.settings.back_categories}" Height="30" Padding="12,0" HorizontalAlignment="Right" Margin="0,12,0,0" />
    </Grid>
  </Grid>
  <Grid x:Name="SettingsConfirmation" Visibility="Collapsed" Background="#B0000000">
    <Border Background="#202B38" BorderBrush="#607080" BorderThickness="1" Padding="20" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel>
        <TextBlock x:Name="SettingsConfirmationText" TextWrapping="Wrap" FontSize="14" />
        <WrapPanel HorizontalAlignment="Right" Margin="0,20,0,0">
          <Button x:Name="CancelConfirmation" Content="{DynamicResource Advisor.settings.cancel}" Height="30" Padding="12,0" />
          <Button x:Name="AcceptConfirmation" Height="30" Padding="12,0" Margin="8,0,0,0" />
        </WrapPanel>
      </StackPanel>
    </Border>
  </Grid>
  <Grid x:Name="OperationReview" Visibility="Collapsed" Background="#B0000000">
    <Border Background="#202B38" BorderBrush="#607080" BorderThickness="1" Padding="20" Margin="12" MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel>
        <TextBlock Text="{DynamicResource Advisor.operation.title}" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />
        <Grid x:Name="OperationPlanNavigation" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button x:Name="PreviousOperationPlan" Content="{DynamicResource Advisor.operation.previous}" Height="26" Padding="8,0" FontSize="12" />
          <TextBlock x:Name="OperationPlanCounter" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0" FontSize="12" />
          <Button x:Name="NextOperationPlan" Grid.Column="2" Content="{DynamicResource Advisor.operation.next}" Height="26" Padding="8,0" FontSize="12" />
        </Grid>
        <StackPanel x:Name="OperationPlanSelection" Margin="0,0,0,8">
          <TextBlock Text="{DynamicResource Advisor.operation.select_multiple}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4" />
          <WrapPanel>
            <CheckBox x:Name="IncludeOperationPlan" Content="{DynamicResource Advisor.operation.include_current}" FontSize="12" />
            <TextBlock x:Name="OperationPlanSelectedCount" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12" />
          </WrapPanel>
        </StackPanel>
        <ScrollViewer x:Name="OperationReviewScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="300" Margin="0,8,0,0">
          <TextBlock x:Name="OperationReviewText" TextWrapping="Wrap" FontSize="14" />
        </ScrollViewer>
        <TextBlock x:Name="OperationReviewFailure" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" Foreground="{StaticResource AdvisorErrorBrush}" />
        <Border BorderBrush="#55606B" BorderThickness="1" Padding="8" Margin="0,12,0,0">
          <ScrollViewer x:Name="OperationReviewTargetsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="80">
            <TextBlock x:Name="OperationReviewTargets" TextWrapping="Wrap" FontSize="14" FontWeight="Bold" />
          </ScrollViewer>
        </Border>
        <WrapPanel HorizontalAlignment="Right" Margin="0,20,0,0">
          <Button x:Name="CloseProposal" Content="{DynamicResource Advisor.operation.back}" Height="30" Padding="12,0" />
          <Button x:Name="ExecuteProposal" Content="{DynamicResource Advisor.operation.accept}" Height="30" Padding="12,0" Margin="8,0,0,0" />
        </WrapPanel>
      </StackPanel>
    </Border>
  </Grid>
</Grid>
