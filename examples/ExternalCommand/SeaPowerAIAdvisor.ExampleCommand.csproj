<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SeaPowerAIAdvisor.ExampleCommand</AssemblyName>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="SeaPowerAIAdvisor.Api" HintPath="$(AdvisorApiPath)" Private="false" />
    <Reference Include="AnchorChain" HintPath="$(AnchorChainDir)\AnchorChain.dll" Private="false" ExternallyResolved="true" />
    <Reference Include="Newtonsoft.Json" HintPath="$(SeaPowerDir)\Sea Power_Data\Managed\Newtonsoft.Json.dll" Private="false" />
    <EmbeddedResource Include="Localization\*.json" LogicalName="SeaPowerAIAdvisor.ExampleCommand.Localization.%(Filename).json" />
    <None Update="_info.ini" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckSdkReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(AdvisorApiPath)' == '' Or !Exists('$(AdvisorApiPath)')" Text="Set AdvisorApiPath to a built contract-version-3 SeaPowerAIAdvisor.Api.dll." />
    <Error Condition="!Exists('$(AnchorChainDir)\AnchorChain.dll')" Text="Set AnchorChainDir to the Anchor Chain MOD directory." />
    <Error Condition="!Exists('$(SeaPowerDir)\Sea Power_Data\Managed\Newtonsoft.Json.dll')" Text="Set SeaPowerDir to the Sea Power installation directory." />
  </Target>
</Project>
